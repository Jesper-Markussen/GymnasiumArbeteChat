<Window x:Class="Alva_V2_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alva Secure Messenger" Height="600" Width="900"
        Background="#36393f">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2f3136">
            <StackPanel Margin="10">
                <TextBlock Text="ALVA" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Username" Foreground="#b9bbbe"/>
                <TextBox x:Name="UserBox" Background="#202225" Foreground="White" BorderThickness="0" Padding="5" Margin="0,5"/>

                <TextBlock Text="Password" Foreground="#b9bbbe"/>
                <PasswordBox x:Name="PassBox" Background="#202225" Foreground="White" BorderThickness="0" Padding="5" Margin="0,5"/>

                <Button Content="Login" Click="Login_Click" Margin="0,10,0,5"/>
                <Button Content="Register" Click="Register_Click" Background="#2d7d46"/>

                <Separator Background="#40444b" Margin="0,20"/>

                <TextBlock Text="TARGET USER" Foreground="#b9bbbe" FontWeight="Bold"/>
                <TextBox x:Name="RecipientBox" Text="alice" Background="#202225" Foreground="White" BorderThickness="0" Padding="5" Margin="0,5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="ChatList" Background="Transparent" BorderThickness="0" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Sender}" Foreground="#5865F2" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Timestamp}" Foreground="#72767d" FontSize="10" Margin="10,2,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Content}" Foreground="#dcddde" TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="1" Background="#40444b" Margin="15" CornerRadius="5" Padding="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MsgBox" Background="Transparent" Foreground="White" BorderThickness="0" 
                             VerticalContentAlignment="Center" FontSize="14" KeyDown="MsgBox_KeyDown"/>

                    <Button Grid.Column="1" Content="Send" Click="Send_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
